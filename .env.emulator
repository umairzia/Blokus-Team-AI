# Used only by `npm run build:emulator` for the automated tests: points the
# app at the local Firebase emulators with a demo- project (demo projects can
# never reach real Firebase resources). Not secret, not production.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-blokus.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-blokus-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-blokus
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_EMULATOR=127.0.0.1:9000:9099
