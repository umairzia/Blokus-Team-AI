# Firebase web app settings for online play. Copy this file to .env.local
# for local development (never commit .env.local). For the live site, set the
# same names as GitHub repository *variables* (Settings > Secrets and
# variables > Actions > Variables); the deploy workflow passes them to the
# build. See docs/FIREBASE_SETUP.md.
#
# These values are public client configuration, not secrets: every visitor's
# browser receives them. Access is controlled by database.rules.json and
# Anonymous Authentication. Never put service-account keys or Admin SDK
# credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
